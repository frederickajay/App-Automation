# Copy to automation/secrets/.env (gitignored) OR store these in your password manager / Keychain
# and load them with load-secrets.sh / load-secrets.ps1. Never commit real values.

# --- Mac (iOS) ---
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/Users/you/.keys/AuthKey_XXXXXXXXXX.p8
MATCH_GIT_URL=git@github.com:you/certificates.git
MATCH_PASSWORD=
IOS_SCHEME=MyApp
IOS_PROJECT=MyApp.xcodeproj

# --- Windows (Android) ---
PLAY_JSON_KEY=C:\Users\you\.keys\play-service-account.json
ANDROID_KEYSTORE_PATH=C:\Users\you\.keys\upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
PLAY_TRACK=internal

# --- Both / optional ---
GH_TOKEN=
NTFY_TOPIC=pick-a-long-random-name-only-you-know
AUTOMATION_WEBHOOK_URL=
# AWS_PROFILE=automation
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json
